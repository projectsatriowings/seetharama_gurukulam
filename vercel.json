{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admission",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/donation-enquiry",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
